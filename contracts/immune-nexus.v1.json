{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-11-oy.com/contracts/immune-nexus.v1.json",
  "title": "IMMUNE NEXUS bounded execution contract",
  "description": "A deterministic software-simulation plane imported from szl-holdings/nexus and governed by IMMUNE. The contract cannot express shell commands, user-provided code, URLs, network targets, or external effectors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor",
    "requestId",
    "program",
    "mode",
    "steps",
    "dt",
    "chaos",
    "drive",
    "seed",
    "repeatEvery"
  ],
  "properties": {
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Caller-asserted actor label. Production identity must be supplied by the host identity plane."
    },
    "requestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "program": {
      "enum": ["lorenz", "harmonic", "vanderpol", "duffing", "lotka", "nemo"]
    },
    "mode": {
      "enum": ["IC", "OP", "HALT", "REP"]
    },
    "steps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2400,
      "description": "NEMO is additionally capped at 400 steps by the runtime."
    },
    "dt": {
      "type": "number",
      "minimum": 0.0004,
      "maximum": 0.08
    },
    "chaos": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "drive": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "seed": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "repeatEvery": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z", "t"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "t": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "bank": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 15,
          "maxItems": 20,
          "description": "Accepted only by NEMO; runtime requires exactly 15 or 20 values."
        }
      }
    },
    "axes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "number", "minimum": 0, "maximum": 1 },
      "description": "Optional caller-supplied axes for a MODELED geometric aggregate. Λ uniqueness remains Conjecture 1 OPEN."
    }
  },
  "x-szl-boundary": {
    "source_repository": "szl-holdings/nexus",
    "source_revision": "617fb49f061c9eb369c4d879a7c29af64c08e72e",
    "public_product": "IMMUNE",
    "capability_plane": "NEXUS",
    "external_calls": 0,
    "external_effectors": false,
    "arbitrary_code": false,
    "arbitrary_urls": false,
    "physical_hardware": false,
    "energy": "UNAVAILABLE",
    "accepted_runs_require": ["SENTRA", "YAWAR", "HUKLLA"]
  }
}
